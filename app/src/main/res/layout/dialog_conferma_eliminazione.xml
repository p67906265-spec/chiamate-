<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pannelloConferma"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_app"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTitoloConferma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMessaggioConferma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnConfermaAnnulla"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_bottone_secondario"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Annulla"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfermaElimina"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_bottone_elimina"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Elimina"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_campo_editor"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinnerTipo"
            android:layout_width="105dp"
            android:layout_height="52dp"
            android:contentDescription="Tipo numero" />

        <EditText
            android:id="@+id/editNumero"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Numero"
            android:inputType="phone"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnRimuovi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rimuovi numero"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/end_call" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnFotoNumero"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawableStart="@android:drawable/ic_menu_gallery"
        android:drawablePadding="10dp"
        android:drawableTint="@color/primary"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Aggiungi foto dalla galleria"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>

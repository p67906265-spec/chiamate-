<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/barraRicerca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Cerca" />

            <EditText
                android:id="@+id/editCerca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="Cerca in rubrica…"
                android:inputType="text"
                android:maxLines="1"
                android:background="@android:color/transparent"
                android:textColor="@color/text_primary"
                android:padding="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/barraSelezioneChiamate"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_barra_selezione"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtConteggioSelezione"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="1 selezionata"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAnnullaSelezione"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_bottone_secondario"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="ANNULLA"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEliminaSelezione"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_bottone_elimina"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="ELIMINA"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="32dp"
            android:paddingBottom="8dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/indiceAlfabetico"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="62dp"
        android:layout_marginBottom="74dp"
        android:background="@color/card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtVuoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/permessi_necessari"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:padding="24dp"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/barraScorciatoie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnScorciatoiaPreferiti"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_nav_preferiti_cuore"
            android:tint="@color/primary"
            android:contentDescription="Preferiti" />

        <ImageButton
            android:id="@+id/btnScorciatoiaTastierino"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginStart="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_nav_tastierino"
            android:tint="@color/primary"
            android:contentDescription="Tastierino" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnNuovoContatto"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_fab_tastierino"
        android:src="@drawable/ic_plus"
        android:contentDescription="Nuovo contatto"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnNuovoMessaggio"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_fab_tastierino"
        android:src="@drawable/ic_plus"
        android:contentDescription="Nuovo messaggio"
        android:visibility="gone" />

</FrameLayout>

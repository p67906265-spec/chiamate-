<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary_dark"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtStato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/chiamata_in_corso"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtNumeroChiamante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDigitato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:minHeight="32dp" />

    <!-- Altoparlante, Muto e In attesa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnMuto"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_dialpad_key"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Muto" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Disattiva audio"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnAltoparlante"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_dialpad_key"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="Altoparlante" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Altoparlante"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnAttesa"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_dialpad_key"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="In attesa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="In attesa"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Tastierino DTMF sempre disponibile durante la chiamata -->
    <GridLayout
        android:id="@+id/gridTasti"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:columnCount="3"
        android:rowCount="4" />

    <!-- Messaggio, Termina, Aggiungi chiamata -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnMessaggio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_dialpad_key"
                android:src="@android:drawable/ic_dialog_email"
                android:contentDescription="Messaggio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Messaggio"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnRiaggancia"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_end"
                android:contentDescription="@string/riaggancia"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnAggiungiChiamata"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_dialpad_key"
                android:src="@android:drawable/ic_menu_add"
                android:contentDescription="Aggiungi chiamata" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aggiungi"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
